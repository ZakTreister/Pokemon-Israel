# Frontend Environment Variables

# API URL for production deployments
# In development, this is automatically set to http://localhost:5000
# In production, set this to your backend API URL
VITE_API_URL=https://your-api-domain.com

# Example for different deployment scenarios:
# For same-domain deployment: VITE_API_URL=https://yourdomain.com
# For separate API domain: VITE_API_URL=https://api.yourdomain.com
# For subdomain: VITE_API_URL=https://api.yourdomain.com